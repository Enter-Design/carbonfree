---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** 'sunrise' runs the scroll-triggered night→day retint. 'day' locks to daylight. */
  palette?: 'sunrise' | 'day';
  /** Selector for the first daylight section. Only used when palette is 'sunrise'. */
  pivot?: string;
  /**
   * Fires when the pivot is this fraction of a viewport from the top.
   * Higher = earlier. 0.8 fires after roughly a quarter of a full-screen hero
   * has scrolled away; 0.55 waits until it is half gone.
   */
  triggerAt?: number;
}

const {
  title,
  description = 'CarbonFree develops, finances, builds and operates utility-scale solar across the Americas.',
  palette = 'sunrise',
  pivot = '#daylight',
  triggerAt = 0.55,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-palette={palette === 'day' ? 'day' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="https://use.typekit.net/ymv7jjc.css" />
    <ClientRouter />
  </head>

  <body
    class="relative overflow-x-hidden font-sans antialiased"
    data-pivot={pivot}
    data-trigger-at={String(triggerAt)}
    data-sunrise={palette === 'day' ? 'off' : 'on'}
  >
    <div class="cf-sky" aria-hidden="true" transition:persist="sky"></div>
    <div class="cf-guides" aria-hidden="true" transition:persist="guides"><div></div></div>

    <Header />
    <main class="relative z-1"><slot /></main>
    <Footer />

    <script>
      import '../scripts/init';
    </script>

  </body>
</html>
