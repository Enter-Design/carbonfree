---
/* Content for this page comes from markdown and src/data, both of which are
   readable at build time — so it stays fully static despite server output. */
export const prerender = true;

import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Blocks from '../components/Blocks.astro';

const page = await getEntry('pages', 'landowners')!;
const { title, description, palette, pivot, triggerAt, blocks } = page.data;
---
<BaseLayout title={title} description={description} palette={palette} pivot={pivot} triggerAt={triggerAt}>
  <Blocks blocks={blocks} />
</BaseLayout>
