---
/* Content for this page comes from markdown and src/data, both of which are
   readable at build time — so it stays fully static despite server output. */
export const prerender = true;

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import MediaFrame from '../../components/ui/MediaFrame.astro';
import { formatDate } from '../../lib/date';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const [lead, ...rest] = posts;
const stamp = (p: (typeof posts)[number]) => p.data.dateLabel ?? formatDate(p.data.date);
---

<BaseLayout
  title="News — CarbonFree Technology"
  description="Announcements, project updates and press releases from CarbonFree Technology."
  pivot="#lead"
  triggerAt={0.9}
>
  <!-- MASTHEAD -->
  <section class="border-b border-hairline pt-46 pb-46">
    <div class="mx-auto flex w-full max-w-site flex-col gap-20 px-8">
      <div class="cf-plate self-start pl-(--cf-inset)">
        <Eyebrow class="cf-reveal">What we&rsquo;re building and where</Eyebrow>
        <h1 class="cf-reveal mt-3 text-[clamp(34px,4.4vw,54px)] font-bold">Newsroom</h1>
      </div>

      <p class="cf-plate cf-reveal ml-auto max-w-[38ch] pr-(--cf-inset) text-right text-[15px] text-ink-muted">
        Announcements, project updates and press releases. Media enquiries to Emma Coyle,
        <a href="mailto:emma@carbonfree.com" class="text-solar underline underline-offset-4">emma@carbonfree.com</a>.
      </p>
    </div>
  </section>

  <!-- LEAD STORY -->
  {lead && (
    <section id="lead" class="border-b border-hairline">
      <div class="mx-auto w-full max-w-site px-8">
        {/*
          One anchor only. Wrapping the whole card in an <a> and putting another
          <a> inside it is invalid, and the HTML parser recovers by closing the
          outer anchor early — which reparents the copy and breaks the grid.
          The title carries the link and stretches over the card instead.
        */}
        <div class="group relative grid items-stretch lg:grid-cols-[1.15fr_1fr]">
          <MediaFrame
            src={lead.data.image}
            alt={lead.data.imageAlt}
            size="h-[260px] lg:h-[400px]"
            eager
            zoom
            class="border-r border-hairline max-lg:border-r-0"
          />
          <div class="cf-plate flex flex-col justify-center py-9 lg:py-10 lg:pl-12">
            <div class="mb-4 flex flex-wrap items-center gap-x-3 font-din text-[12px] tracking-[0.12em] uppercase">
              <span class="text-solar">{stamp(lead)}</span>
              <span class="text-ink-muted/60">&middot;</span>
              <span class="text-ink-muted">{lead.data.category}</span>
            </div>
            <h2 class="mb-4 max-w-[20ch] text-[clamp(26px,2.9vw,40px)] leading-[1.08] font-bold">
              <a
                href={`/news/${lead.id}`}
                class="transition duration-200 group-hover:text-solar after:absolute after:inset-0 after:content-['']"
              >
                {lead.data.title}
              </a>
            </h2>
            <p class="mb-6 max-w-[50ch] text-[16.5px] text-ink-muted">{lead.data.dek}</p>
            <span class="inline-flex items-center gap-2 text-[15px] font-bold text-solar transition-all duration-200 group-hover:gap-3 group-hover:text-solar-deep">
              Read the story <span aria-hidden="true">&rarr;</span>
            </span>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- THE WIRE -->
  {rest.length > 0 && (
    <section class="pt-12 pb-24">
      <div class="mx-auto w-full max-w-site px-8">
        <div class="cf-plate mb-2 flex items-baseline justify-between pl-(--cf-inset)">
          <Eyebrow>More from CarbonFree</Eyebrow>
          <span class="font-din text-[12px] tracking-[0.1em] text-ink-muted/70 uppercase">
            {posts.length} {posts.length === 1 ? 'story' : 'stories'}
          </span>
        </div>

        <div class="border-t border-hairline">
          {rest.map((post) => (
            <a
              href={`/news/${post.id}`}
              class="group grid items-center gap-x-7 border-b border-hairline py-5 transition duration-200 hover:bg-white/[0.02] lg:grid-cols-[150px_170px_1fr_auto]"
            >
              <MediaFrame
                src={post.data.image}
                alt=""
                size="h-[86px] w-[150px] border border-hairline max-lg:w-full"
                zoom
              />

              <div class="flex flex-col gap-1 font-din text-[11.5px] tracking-[0.1em] uppercase">
                <span class="text-solar">{stamp(post)}</span>
                <span class="text-ink-muted/70">{post.data.category}</span>
              </div>

              <div class="min-w-0">
                <h3 class="mb-1.5 max-w-[52ch] text-[19px] leading-snug font-bold transition duration-200 group-hover:text-solar">
                  {post.data.title}
                </h3>
                <p class="max-w-[68ch] text-[14.5px] text-ink-muted">{post.data.dek}</p>
              </div>

              <span
                class="hidden self-center text-solar transition-transform duration-200 group-hover:translate-x-1 lg:block"
                aria-hidden="true"
              >&rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <ContactCTA
    title="Talk to us."
    body="Media enquiries, partnership questions, or anything else &mdash; we&rsquo;d like to hear from you."
  />
</BaseLayout>
