---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import ArrowLink from '../../components/ArrowLink.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const [lead, ...rest] = posts;
const stamp = (p: (typeof posts)[number]) =>
  p.data.dateLabel ?? p.data.date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long' });
---

<BaseLayout
  title="News — CarbonFree Technology"
  description="Announcements, project updates and press releases from CarbonFree Technology."
  pivot="#daylight"
>
  <section class="border-b border-hairline pt-44 pb-20">
    <div class="cf-plate mx-auto w-full max-w-site px-8">
      <Eyebrow class="cf-reveal">Newsroom</Eyebrow>
      <h1 class="cf-reveal mt-5 max-w-[18ch] text-display font-bold">
        What we&rsquo;re <span class="cf-gradient-text">building, and where.</span>
      </h1>
      <p class="cf-reveal mt-6 max-w-[58ch] text-lede text-ink-muted">
        Announcements, project updates and press releases. For media enquiries, contact
        Emma Coyle at <a href="mailto:emma@carbonfree.com" class="text-solar underline underline-offset-4">emma@carbonfree.com</a>.
      </p>
    </div>
  </section>

  {lead && (
    <section id="daylight" class="border-b border-hairline">
      <div class="mx-auto w-full max-w-site px-8">
        <a href={`/news/${lead.id}`} class="group grid gap-0 py-0 lg:grid-cols-[1.1fr_0.9fr]">
          <div class="cf-reveal relative min-h-[300px] overflow-hidden lg:min-h-[440px]">
            <img
              src={lead.data.image}
              alt={lead.data.imageAlt}
              class="absolute inset-0 size-full object-cover opacity-80 transition duration-500 group-hover:scale-[1.03] group-hover:opacity-100"
            />
          </div>
          <div class="cf-plate cf-reveal flex flex-col justify-center border-hairline cell-inset py-12 max-lg:border-t lg:border-l lg:py-16 lg:pl-14">
            <div class="mb-4 flex flex-wrap items-center gap-x-3 font-din text-[12.5px] tracking-[0.1em] uppercase">
              <span class="text-solar">{stamp(lead)}</span>
              <span class="text-ink-muted">{lead.data.category}</span>
            </div>
            <h2 class="mb-5 max-w-[22ch] text-headline font-bold transition duration-200 group-hover:text-solar">
              {lead.data.title}
            </h2>
            <p class="mb-7 max-w-[52ch] text-[17px] text-ink-muted">{lead.data.dek}</p>
            <ArrowLink href={`/news/${lead.id}`}>Read the announcement</ArrowLink>
          </div>
        </a>
      </div>
    </section>
  )}

  {rest.length > 0 && (
    <section class="py-24">
      <div class="mx-auto w-full max-w-site px-8">
        <Eyebrow class="cf-reveal mb-9 pl-(--cf-inset)">Earlier</Eyebrow>
        <div class="cf-reveal grid border-t border-hairline">
          {rest.map((post) => (
            <a
              href={`/news/${post.id}`}
              class="cf-plate group grid items-start gap-x-10 gap-y-3 border-b border-hairline cell-inset py-8 transition duration-300 lg:grid-cols-[200px_1fr_auto]"
            >
              <div class="flex flex-wrap items-center gap-x-3 font-din text-[12.5px] tracking-[0.1em] uppercase">
                <span class="text-solar">{stamp(post)}</span>
                <span class="text-ink-muted">{post.data.category}</span>
              </div>
              <div>
                <h3 class="mb-2 max-w-[46ch] text-xl font-bold transition duration-200 group-hover:text-solar">
                  {post.data.title}
                </h3>
                <p class="max-w-[62ch] text-[15px] text-ink-muted">{post.data.dek}</p>
              </div>
              <span class="self-center font-bold text-solar transition-all duration-200 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <ContactCTA
    title="Talk to us."
    body="Media enquiries, partnership questions, or anything else — we&rsquo;d like to hear from you."
  />
</BaseLayout>
