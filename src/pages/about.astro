---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HeroCard from '../components/HeroCard.astro';
import StatBar from '../components/StatBar.astro';
import SectionHead from '../components/SectionHead.astro';
import NumberedGrid from '../components/NumberedGrid.astro';
import Callout from '../components/Callout.astro';
import RegionChips from '../components/RegionChips.astro';
import Timeline from '../components/Timeline.astro';
import Split from '../components/Split.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import ArrowLink from '../components/ArrowLink.astro';
import { values, leadership } from '../data/about';
import { regions } from '../data/home';
import { facts } from '../data/site';

const trust = [
  { strong: '100%', tail: 'Canadian-owned' },
  { strong: facts.projects, tail: 'projects delivered' },
  { strong: '3', tail: 'countries' },
  { lead: 'Founded in', strong: 'Toronto', tail: 'in 2006' },
];
---

<BaseLayout
  title="About CarbonFree — Twenty years of utility-scale solar"
  description="CarbonFree has developed, financed, built and operated utility-scale solar since 2006 — 137 projects and 780 MWdc across Canada, the United States and Chile."
  pivot="#daylight"
>
  <Hero
    eyebrow="About CarbonFree"
    image="https://carbonfree.com/wp-content/uploads/2014/11/KS.jpg"
    imageAlt="Kingston Solar, Ontario"
    trust={trust}
  >
    <h1 slot="headline" class="cf-reveal max-w-[19ch] text-display font-bold">
      We build solar at scale to <span class="cf-gradient-text-dual">power Canada&rsquo;s clean energy future.</span>
    </h1>

    <p slot="lede" class="cf-reveal my-6.5 max-w-[58ch] text-lede text-ink-muted">
      That isn&rsquo;t a slogan. It&rsquo;s a description of what CarbonFree has done since 2006 &mdash;
      {facts.projects} projects and 780&nbsp;MW<sub>dc</sub> commissioned across Canada, the United
      States and Chile, with more than a gigawatt still to build.
    </p>

    <div slot="actions" class="cf-reveal flex flex-wrap items-center gap-5.5">
      <Button href="#timeline">Twenty years, year by year &rarr;</Button>
      <Button href="#leadership" variant="ghost">Meet the team &rarr;</Button>
    </div>

    <HeroCard slot="aside" flag="Our mission">
      <blockquote class="mb-4.5 text-[clamp(21px,2.1vw,27px)] leading-[1.18] font-bold tracking-[-0.02em]">
        To add clean generation to Ontario&rsquo;s grid &mdash;
        <span class="cf-gradient-text-dual">and lower the cost of power for everyone on it.</span>
      </blockquote>
      <p class="text-[14.5px] text-ink-muted">
        Ontario is projecting an 80 TWh electricity deficit by 2050 and has committed to procuring
        9 GW of new generation for service between 2029 and 2034. Solar is the fastest way to deliver it.
      </p>
      <div class="my-4 h-px bg-hairline"></div>
      <div class="flex items-start gap-3">
        <span class="mt-1.5 size-2 shrink-0 rotate-45 bg-solar"></span>
        <p class="text-[13.5px] text-ink-muted">
          &ldquo;Solar projects can contribute positively to the Ontario grid while generating carbon
          free electricity and <b class="text-ink">reducing the cost to Ontario ratepayers</b>.&rdquo;
          &mdash; Daniel Soper, CEO
        </p>
      </div>
    </HeroCard>
  </Hero>

  <StatBar />

  <!-- Daylight begins here -->
  <section id="daylight" class="py-28">
    <div class="mx-auto w-full max-w-site px-8">
      <SectionHead
        eyebrow="What we value"
        title="Five things we don&rsquo;t compromise on."
        body="Not aspirations. Each one is visible in how a CarbonFree project is actually structured."
      />
      <NumberedGrid items={values} />
      <Callout title="05 — Canadian-owned, and staying that way">
        CarbonFree is 100% Canadian-owned and has been headquartered in Toronto since it was founded
        in 2006. The capital we raise is deployed into Canadian infrastructure, the jobs sit here, and
        the people deciding about a project in Rainy River are a few hours&rsquo; drive away, not a
        few time zones.
      </Callout>
      <RegionChips items={regions} />
    </div>
  </section>

  <section id="timeline" class="pb-28">
    <div class="mx-auto w-full max-w-site px-8">
      <SectionHead
        eyebrow="Twenty years"
        title="Successful at every stage of this company&rsquo;s life."
        body="Select a year to see what happened. Arrow keys work too."
      />
      <Timeline />
    </div>
  </section>

  <section id="partners">
    <Split
      image="https://carbonfree.com/wp-content/uploads/2014/11/GRS1.jpg"
      imageAlt="Grand Renewable Solar"
      reverse
      badgeValue="3"
      badgeLabel="First Nations partners on our<br>2026 awarded projects"
    >
      <Eyebrow>Indigenous partnership</Eyebrow>
      <h2 class="mt-4.5 mb-5.5 text-headline font-bold">Fifteen years of partnerships, not consultations.</h2>
      <p class="mb-4.5 text-[17px] text-ink-muted">
        CarbonFree has developed utility-scale projects with First Nations communities for more than
        fifteen years, beginning with Canada&rsquo;s largest First Nations community on Grand Renewable
        Solar in 2013. All three of our 2026 IESO-awarded projects were developed in partnership with
        the communities whose territories host them.
      </p>
      <ul class="mt-5.5 grid gap-4">
        <li class="flex items-start gap-3.5 text-base"><span class="cf-mark mt-1.75"></span><span><b>A controlling economic interest</b> in the project partnership, with governance representation.</span></li>
        <li class="flex items-start gap-3.5 text-base"><span class="cf-mark mt-1.75"></span><span><b>No capital at risk.</b> CarbonFree funds development; loan structures let a community participate without fronting capital.</span></li>
        <li class="flex items-start gap-3.5 text-base"><span class="cf-mark mt-1.75"></span><span><b>Decisions on your timeline</b> &mdash; the level and timing of investment are the community&rsquo;s to set.</span></li>
      </ul>
      <div class="mt-6.5"><ArrowLink href="#contact">How our partnerships are structured</ArrowLink></div>
    </Split>
  </section>

  <section id="leadership" class="py-28">
    <div class="mx-auto w-full max-w-site px-8">
      <SectionHead
        eyebrow="Leadership"
        title="Developers, financiers, lawyers, engineers and asset managers."
        body="Many of whom have worked together for well over a decade. The depth and continuity of this team is what carries a project from first parcel to the grid."
      />
      <div data-rail class="cf-reveal grid border-t border-l border-hairline sm:grid-cols-2 lg:grid-cols-3">
        {leadership.map((p) => (
          <div class="group relative overflow-hidden border-r border-b border-hairline bg-white/[0.02] cell-inset pt-7 pb-7.5 transition duration-300">
            <span class="absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 bg-linear-to-r from-solar to-solar-deep transition-transform duration-300 group-hover:scale-x-100"></span>
            <div class="text-[17px] font-bold">{p.name}</div>
            <div class="mt-1.5 font-din text-[13.5px] text-ink-muted">{p.role}</div>
          </div>
        ))}
      </div>
      <div class="cf-reveal mt-10 pl-(--cf-inset)"><ArrowLink href="/leadership">Full leadership profiles</ArrowLink></div>
    </div>
  </section>

  <ContactCTA
    title="Twenty years in, we&rsquo;re still building."
    body="Land to lease, power to buy, a community project, or capital to deploy — we&rsquo;d like to hear from you."
    showDoors
  />
</BaseLayout>
