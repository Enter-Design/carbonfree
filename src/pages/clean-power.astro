---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HeroCard from '../components/HeroCard.astro';
import KeyFacts from '../components/KeyFacts.astro';
import SectionHead from '../components/SectionHead.astro';
import NumberedGrid from '../components/NumberedGrid.astro';
import Compare from '../components/Compare.astro';
import Steps from '../components/Steps.astro';
import FitList from '../components/FitList.astro';
import Split from '../components/Split.astro';
import Faq from '../components/Faq.astro';
import Callout from '../components/Callout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import { keyFacts, benefits, compare, steps, fit, expectations, faq } from '../data/cleanpower';
import { facts } from '../data/site';

const trust = [
  { lead: 'For', strong: 'large', tail: 'electricity users' },
  { strong: 'No', tail: 'on-site equipment' },
  { lead: 'Clean energy credits', strong: 'included', tail: '' },
  { strong: facts.projects, tail: 'projects delivered since 2006' },
];
---

<BaseLayout
  title="Buy clean power — contract a fixed rate | CarbonFree"
  description="Buy power directly from CarbonFree solar projects at a price fixed by contract for 15 to 20 years, with the clean energy credits included and nothing installed on your site."
  pivot="#daylight"
  triggerAt={0.8}
>
  <Hero
    eyebrow="Fix your electricity costs"
    image="https://images.unsplash.com/photo-1466611653911-95081537e5b7?auto=format&fit=crop&w=2000&q=80"
    imageAlt="Utility-scale solar array"
    trust={trust}
  >
    <h1 slot="headline" class="cf-reveal max-w-[19ch] text-display font-bold">
      Know what you&rsquo;ll pay for power &mdash; <span class="cf-gradient-text-dual">for the next 20 years.</span>
    </h1>

    <p slot="lede" class="cf-reveal my-6.5 max-w-[58ch] text-lede text-ink-muted">
      Electricity costs are volatile, climbing, and impossible to budget more than a year out. Buy
      power directly from our solar projects at a price fixed by contract for 15 to 20 years. Your
      rate is set, market spikes don&rsquo;t reach you, and the clean energy credits are yours.
    </p>

    <div slot="actions" class="cf-reveal flex flex-wrap items-center gap-5.5">
      <Button href="#assessment">See what a fixed rate would look like &rarr;</Button>
      <Button href="#how" variant="ghost">How it works &rarr;</Button>
    </div>

    <HeroCard slot="aside" flag="Why now">
      <blockquote class="mb-4.5 text-[clamp(19px,1.9vw,24px)] leading-[1.2] font-bold tracking-[-0.02em]">
        Ontario is buying <span class="cf-gradient-text-dual">9 GW of new generation</span> and the cost is landing on your bill.
      </blockquote>
      <p class="text-[14.5px] text-ink-muted">
        System reinvestment, electrification, nuclear refurbishment and new procurement are all
        adding pressure. For Class A customers, Global Adjustment makes the total harder still to
        forecast &mdash; because it depends on when you draw, not just how much.
      </p>
    </HeroCard>
  </Hero>

  <div id="daylight"><KeyFacts items={keyFacts} /></div>

  <section class="py-28">
    <div class="mx-auto w-full max-w-site px-8">
      <SectionHead
        eyebrow="Why large customers look at this"
        title="A hedge, not a construction project."
        body="For Class A customers, cost risk isn&rsquo;t limited to the price of power. A meaningful share of the total comes from Global Adjustment, allocated by your contribution to Ontario&rsquo;s highest peak demand hours."
      />
      <NumberedGrid items={benefits} />
      <Callout title="What this is, in plain terms">
        You contract for a share of the output of a real Ontario solar project at a price agreed up
        front, and you receive the clean energy credits that come with it. The instrument is a
        corporate power purchase agreement — a corporate PPA. Nothing is installed at your facility.
      </Callout>
    </div>
  </section>

  <section class="pb-28">
    <div class="mx-auto w-full max-w-site px-8">
      <SectionHead
        eyebrow="The comparison"
        title="Market exposure versus contracted supply."
        body="This isn&rsquo;t a bet on next month&rsquo;s price. It&rsquo;s a way to make a portion of a large, volatile cost behave predictably across a full market cycle."
      />
      <Compare headA={compare.headA} headB={compare.headB} rows={compare.rows} />
      <p class="cf-reveal mt-6.5 max-w-[70ch] pl-(--cf-inset) text-[15px] text-ink-muted">
        Whether a contract delivers value against market prices depends on how those prices move
        over the term. What it delivers with certainty is a known price on a defined portion of your
        load, and the credits attached to it.
      </p>
    </div>
  </section>

  <section id="how" class="pb-28">
    <div class="mx-auto w-full max-w-site px-8">
      <SectionHead eyebrow="How it works" title="From first conversation to contracted supply." />
      <Steps items={steps} />
    </div>
  </section>

  <section id="fit">
    <Split
      image="https://carbonfree.com/wp-content/uploads/2014/11/KS.jpg"
      imageAlt="Kingston Solar, Ontario"
      reverse
      badgeValue="381 MW"
      badgeLabel="awarded in Ontario&rsquo;s<br>2026 IESO procurement"
    >
      <Eyebrow>Is your facility a fit?</Eyebrow>
      <h2 class="mt-4.5 mb-5.5 text-headline font-bold">This is probably worth evaluating if you have&hellip;</h2>
      <FitList items={fit} />
      <p class="mt-6.5 text-[15px] text-ink-muted">
        Not sure? That&rsquo;s what the first assessment is for. Share your load profile and
        we&rsquo;ll tell you whether it&rsquo;s worth evaluating &mdash; at no cost, and with no
        commitment either way.
      </p>
    </Split>
  </section>

  <section class="py-28">
    <div class="mx-auto w-full max-w-site px-8">
      <SectionHead eyebrow="What to expect" title="Clear answers before you commit." />
      <FitList items={expectations} />
    </div>
  </section>

  <section id="faq" class="pb-28">
    <div class="mx-auto w-full max-w-site px-8">
      <SectionHead eyebrow="FAQ" title="Questions Class A customers ask." />
      <Faq items={faq} />
    </div>
  </section>

  <div id="assessment">
    <ContactCTA
      eyebrow="Free assessment"
      title="See what a fixed rate would look like."
      body="Share your facility&rsquo;s load profile and we&rsquo;ll come back with whether a contract makes sense for you — and if it doesn&rsquo;t, we&rsquo;ll tell you that."
      submit="Request my assessment"
      note="No cost · No obligation · Reviewed by the CarbonFree commercial team"
      fields={[
        { label: 'Full name', half: true },
        { label: 'Title', half: true },
        { label: 'Company', half: true },
        { label: 'Email', type: 'email', half: true },
        { label: 'Facility location', half: true },
        { label: 'Class A customer?', type: 'select', options: ['Yes', 'No', 'Not sure'], half: true },
        { label: 'Approximate annual electricity usage', half: true },
        { label: 'Sustainability or clean energy targets', half: true },
        { label: 'Anything else we should know?', type: 'textarea' },
      ]}
    />
  </div>
</BaseLayout>
