---
import Card from './ui/Card.astro';
import Chip from './ui/Chip.astro';
import MediaFrame from './ui/MediaFrame.astro';
import type { Leader } from '../data/leadership';

interface Props { people: Leader[] }
const { people } = Astro.props;

/*
  The opening sentence of each bio, taken from CarbonFree's own leadership copy
  — real text, trimmed, never rewritten. Splitting on ". " alone would break on
  "Ph.D." or "U.S."; requiring a capital after the break is enough for these.
*/
const opener = (bio: string[]) => {
  const first = bio[0] ?? '';
  const end = first.search(/\.\s+(?=[A-Z])/);
  return end === -1 ? first : first.slice(0, end + 1);
};
---
{/*
  Same photographs, crop and plate as /leadership — object-top so the frame
  lands on the face rather than the middle of the chest.
*/}
<div class="cf-reveal grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
  {people.map((person) => (
    <Card as="article" bar="top" class="flex flex-col">
      <MediaFrame
        src={person.photo}
        alt=""
        size="aspect-square"
        zoom
        imgAttrs={{ width: '440', height: '440' }}
        class="border-b border-hairline [&_img]:object-top"
      />
      <div class="flex grow flex-col cell-inset py-6.5">
        <h3 class="text-[17px] font-bold">{person.name}</h3>
        <p class="mt-1.5 font-din text-[12.5px] leading-snug tracking-[0.04em] text-solar uppercase">{person.role}</p>
        <p class="mt-3.5 text-[14.5px] leading-relaxed text-ink-muted">{opener(person.bio)}</p>
        {/* Wrapper carries the push-to-bottom; padding on the chip itself would inflate it. */}
        {person.linkedin && (
          <div class="mt-auto pt-6">
            <Chip
              as="a"
              href={person.linkedin}
              rel="noopener noreferrer"
              target="_blank"
              interactive
              class="!px-4 !py-2.5 !text-[12.5px] !tracking-[0.04em]"
            >LinkedIn &rarr;</Chip>
          </div>
        )}
      </div>
    </Card>
  ))}
</div>
