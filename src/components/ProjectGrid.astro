---
import ProjectCard from './ui/ProjectCard.astro';
import { projects } from '../data/home';
---
<div class="cf-reveal grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {projects.map((p) => (
    <ProjectCard
      name={p.name}
      img={p.img}
      tag={p.tag}
      place={p.place}
      note={p.note}
      capacity={'capacity' in p ? p.capacity : undefined}
    />
  ))}
</div>
