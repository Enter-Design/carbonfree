---
import { projects } from '../data/home';
---
<div data-rail class="cf-reveal grid border-t border-l border-hairline sm:grid-cols-2 lg:grid-cols-3">
  {projects.map((p) => (
    <article class="group relative overflow-hidden border-r border-b border-hairline bg-surface-alt">
      <div class="relative h-[230px] overflow-hidden">
        {'capacity' in p && p.capacity && (
          <span class="absolute top-4 left-4 z-2 border border-hairline bg-veil-mid px-3 py-1.75 font-din-narrow text-[17px] font-bold text-signal backdrop-blur-[6px]">
            {p.capacity}
          </span>
        )}
        <img
          src={p.img}
          alt={p.name}
          class="size-full object-cover opacity-72 transition duration-500 group-hover:scale-105 group-hover:opacity-90"
        />
        <div class="absolute inset-0 bg-linear-to-t from-veil-heavy to-veil-light"></div>
      </div>
      <div class="cell-inset pt-5.5 pb-6.5">
        <span class="font-din text-xs font-bold tracking-[0.12em] text-solar uppercase">{p.tag}</span>
        <h3 class="my-2 text-[19px] font-bold">{p.name}</h3>
        <div class="flex flex-wrap gap-x-4 gap-y-1.5 font-din text-[13.5px] text-ink-muted">
          <span>{p.place}</span><span>{p.note}</span>
        </div>
      </div>
    </article>
  ))}
</div>
