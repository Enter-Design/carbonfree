---
import Chip from './ui/Chip.astro';
import MediaFrame from './ui/MediaFrame.astro';
import { milestones } from '../data/about';

/*
  Milestone rotator.

  Every year sits on the axis in muted grey so the whole history is legible at
  a glance. Hovering a year raises a pin and flag above the line, darkens that
  label, and rotates its milestone to the front of the stage — with the one
  before and the one after held either side in depth, so it reads as a carousel
  mid-turn rather than a slideshow.

  Without JavaScript, or with prefers-reduced-motion, the stage is a plain
  vertical list and the axis is a static index.
*/
const first = milestones[0].year;
const last = milestones[milestones.length - 1].year;
---
<section data-timeline class="relative">
  <!-- STAGE -->
  <div
    data-stage
    class="relative grid gap-10 [perspective:1500px] lg:min-h-[440px] [.is-live_&]:block [.is-live_&]:overflow-hidden"
  >
    {milestones.map((m, i) => (
      <article
        data-slide
        data-index={i}
        class="grid items-center gap-8 border-t border-hairline pt-10 [transform-style:preserve-3d] [backface-visibility:hidden] lg:grid-cols-[320px_1fr] lg:gap-12 lg:border-0 lg:pt-0 [.is-live_&]:absolute [.is-live_&]:inset-0 [.is-live_&]:border-0 [.is-live_&]:pt-0"
      >
        <MediaFrame
          src={m.img}
          size="aspect-[4/3] border border-hairline lg:aspect-auto lg:h-[240px]"
          eager={i < 3}
          imgAttrs={{ 'data-slide-img': '' }}
        />

        <div>
          <div data-anim class="font-din text-[11px] font-bold tracking-[0.18em] text-solar uppercase">
            {m.tick}
          </div>
          <div
            data-anim
            class="cf-gradient-text mt-2.5 font-din-narrow text-[clamp(38px,4.2vw,58px)] leading-[0.95] font-bold tracking-[-0.02em]"
          >
            {m.year}
          </div>
          <h3 data-anim class="mt-3.5 mb-4 max-w-[22ch] text-subhead font-bold">{m.title}</h3>
          <p data-anim class="max-w-[56ch] text-[16.5px] text-ink-muted">{m.body}</p>
          <div data-anim class="mt-6 flex flex-wrap gap-2.25">
            {m.chips.map((c) => (
              <Chip>{c}</Chip>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- AXIS -->
  <div data-axis class="relative mt-16 select-none">
    <div class="mb-14 flex items-baseline justify-between font-din text-[12px] tracking-[0.14em] text-ink-muted/70 uppercase">
      <span>{first}</span><span>{last}</span>
    </div>

    <div
      data-rail
      tabindex="0"
      role="group"
      aria-label="Company milestones"
      class="relative h-px w-full bg-hairline outline-none focus-visible:ring-1 focus-visible:ring-solar/50"
    >
      <div data-fill class="absolute inset-y-0 left-0 w-0 bg-linear-to-r from-solar to-solar-deep transition-[width] duration-500 ease-out"></div>

      {milestones.map((m, i) => (
        <button
          type="button"
          data-marker
          data-index={i}
          aria-label={`${m.year} — ${m.title}`}
          class="group absolute top-1/2 -translate-x-1/2 -translate-y-1/2 cursor-pointer px-3 py-6"
          style={`left:${(i / (milestones.length - 1)) * 100}%`}
        >
          {/* Pin and flag — rises above the line for the active year */}
          <span class="pointer-events-none absolute bottom-[calc(50%+6px)] left-1/2 flex -translate-x-1/2 translate-y-1.5 flex-col items-center opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100 group-data-[active]:translate-y-0 group-data-[active]:opacity-100">
            <span class="border border-solar/40 bg-panel px-2.5 py-1.5 font-din text-[10.5px] font-bold tracking-[0.12em] whitespace-nowrap text-ink uppercase shadow-[0_6px_18px_rgb(0_0_0/0.12)]">
              {m.tick}
            </span>
            <span class="h-3.5 w-px bg-linear-to-b from-solar/60 to-solar"></span>
          </span>

          {/* Pinpoint on the line */}
          <span class="block size-1.5 rotate-45 bg-ink-muted/45 transition-all duration-300 group-hover:scale-[1.9] group-hover:bg-solar group-data-[active]:scale-[1.9] group-data-[active]:bg-solar"></span>

          {/* Year — always visible, muted until active */}
          <span class="absolute top-[calc(50%+14px)] left-1/2 -translate-x-1/2 font-din-narrow text-[12.5px] font-bold whitespace-nowrap text-ink-muted/45 transition-all duration-300 group-hover:scale-110 group-hover:text-ink group-data-[active]:scale-110 group-data-[active]:text-ink">
            {m.year}
          </span>
        </button>
      ))}
    </div>

    <div class="mt-16 flex items-center gap-5 font-din text-[12.5px] tracking-[0.1em] text-ink-muted uppercase">
      <span data-readout class="tabular-nums">1 / {milestones.length}</span>
      <span data-hint>Hover the timeline</span>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function mountTimeline(): void {
    const section = document.querySelector<HTMLElement>('[data-timeline]');
    const stage = document.querySelector<HTMLElement>('[data-stage]');
    if (!section || !stage) return;

    const reduced = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;
    if (reduced) {
      document.querySelector<HTMLElement>('[data-hint]')?.remove();
      document.querySelector<HTMLElement>('[data-readout]')?.remove();
      return;
    }

    section.classList.add('is-live');

    const slides = gsap.utils.toArray<HTMLElement>('[data-slide]');
    const markers = gsap.utils.toArray<HTMLElement>('[data-marker]');
    const rail = section.querySelector<HTMLElement>('[data-rail]');
    const fill = section.querySelector<HTMLElement>('[data-fill]');
    const readout = section.querySelector<HTMLElement>('[data-readout]');

    const n = slides.length;
    const span = n - 1;
    let current = 0;
    let timer = 0;
    let engaged = false;

    /* Where a slide sits given its distance from the active one.
       -1 and +1 stay on stage, held back in depth and turned toward the front. */
    function pose(offset: number) {
      if (offset === 0) {
        return { xPercent: 0, z: 0, rotationY: 0, scale: 1, autoAlpha: 1, zIndex: 3 };
      }
      if (Math.abs(offset) === 1) {
        const s = Math.sign(offset);
        return { xPercent: 56 * s, z: -320, rotationY: -26 * s, scale: 0.9, autoAlpha: 0.18, zIndex: 2 };
      }
      const s = Math.sign(offset);
      return { xPercent: 72 * s, z: -520, rotationY: -34 * s, scale: 0.84, autoAlpha: 0, zIndex: 1 };
    }

    function layout(active: number, animate = true): void {
      slides.forEach((slide, i) => {
        const props = pose(i - active);
        if (animate) {
          gsap.to(slide, { ...props, duration: 0.62, ease: 'power3.out', overwrite: 'auto' });
        } else {
          gsap.set(slide, props);
        }
      });
    }

    function show(next: number): void {
      if (next < 0 || next >= n || next === current) return;
      current = next;
      layout(current);

      /* Only the card that just arrived re-staggers its contents. */
      const bits = slides[current].querySelectorAll<HTMLElement>('[data-anim]');
      gsap.fromTo(
        bits,
        { autoAlpha: 0, y: 18 },
        { autoAlpha: 1, y: 0, duration: 0.42, stagger: 0.05, ease: 'power2.out', overwrite: 'auto', delay: 0.14 },
      );

      const img = slides[current].querySelector<HTMLElement>('[data-slide-img]');
      if (img) gsap.fromTo(img, { scale: 1.09 }, { scale: 1, duration: 1.1, ease: 'power2.out', overwrite: 'auto' });

      const pct = span === 0 ? 0 : (current / span) * 100;
      if (fill) fill.style.width = `${pct}%`;
      if (readout) readout.textContent = `${current + 1} / ${n}`;
      markers.forEach((m, i) =>
        i === current ? m.setAttribute('data-active', '') : m.removeAttribute('data-active'),
      );
    }

    layout(0, false);
    markers[0]?.setAttribute('data-active', '');

    markers.forEach((marker, i) => {
      const take = () => { engaged = true; stopAuto(); show(i); };
      marker.addEventListener('mouseenter', take);
      marker.addEventListener('focus', take);
      marker.addEventListener('click', take);
    });

    rail?.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      engaged = true;
      stopAuto();
      show(current + (e.key === 'ArrowRight' ? 1 : -1));
    });

    function startAuto(): void {
      stopAuto();
      timer = window.setInterval(() => show((current + 1) % n), 4200);
    }
    function stopAuto(): void {
      if (timer) window.clearInterval(timer);
      timer = 0;
    }

    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !engaged) startAuto();
        else stopAuto();
      },
      { threshold: 0.35 },
    );
    io.observe(section);

    document.addEventListener('astro:before-swap', () => { stopAuto(); io.disconnect(); }, { once: true });
  }

  document.addEventListener('astro:page-load', mountTimeline);
</script>
