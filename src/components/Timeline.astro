---
import { milestones } from '../data/about';

/*
  Scroll-driven timeline.

  The section pins and a playhead travels left to right along a single axis
  spanning 2006 to today. Year markers sit along that axis and light up as the
  playhead reaches them; the stage above cross-fades each milestone in as its
  moment arrives and back out as the playhead moves on.

  Without JavaScript, or with prefers-reduced-motion, the stage renders as a
  plain vertical list and the axis becomes a static index. Nothing is hidden.
*/
const first = milestones[0].year;
const last = milestones[milestones.length - 1].year;
---
<section data-timeline class="relative">
  <!-- STAGE -->
  <div
    data-stage
    class="relative grid gap-10 lg:min-h-[420px] [.is-live_&]:block"
  >
    {milestones.map((m, i) => (
      <article
        data-slide
        data-index={i}
        class="grid items-center gap-8 border-t border-hairline pt-10 lg:grid-cols-[320px_1fr] lg:gap-12 lg:border-0 lg:pt-0 [.is-live_&]:absolute [.is-live_&]:inset-0 [.is-live_&]:border-0 [.is-live_&]:pt-0"
      >
        <div class="relative aspect-[4/3] overflow-hidden border border-hairline bg-[#0b0d0f] lg:aspect-auto lg:h-[240px]">
          <img
            data-slide-img
            src={m.img}
            alt=""
            loading={i < 2 ? 'eager' : 'lazy'}
            class="size-full object-cover opacity-92"
          />
          <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/65 to-transparent to-60%"></div>
        </div>

        <div>
          <div data-anim class="font-din text-[11px] font-bold tracking-[0.18em] text-solar uppercase">
            {m.tick}
          </div>
          <div
            data-anim
            class="cf-gradient-text mt-2.5 font-din-narrow text-[clamp(38px,4.2vw,58px)] leading-[0.95] font-bold tracking-[-0.02em]"
          >
            {m.year}
          </div>
          <h3 data-anim class="mt-3.5 mb-4 max-w-[22ch] text-subhead font-bold">{m.title}</h3>
          <p data-anim class="max-w-[56ch] text-[16.5px] text-ink-muted">{m.body}</p>
          <div data-anim class="mt-6 flex flex-wrap gap-2.25">
            {m.chips.map((c) => (
              <span class="border border-hairline bg-panel px-3.25 py-1.75 font-din text-[12.5px] tracking-[0.06em] text-ink uppercase">
                {c}
              </span>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- AXIS -->
  <div data-axis class="relative mt-14 pt-8 select-none">
    <div class="mb-6 flex items-baseline justify-between font-din text-[12px] tracking-[0.14em] text-ink-muted uppercase">
      <span>{first}</span><span>{last}</span>
    </div>

    <div class="relative h-px w-full bg-hairline">
      <div data-fill class="absolute inset-y-0 left-0 w-0 bg-linear-to-r from-solar to-solar-deep"></div>
      <span
        data-playhead
        class="absolute top-1/2 left-0 hidden size-3 -translate-x-1/2 -translate-y-1/2 rotate-45 bg-solar shadow-[0_0_0_5px_var(--cf-surface)] [.is-live_&]:block"
      ></span>

      {milestones.map((m, i) => (
        <button
          type="button"
          data-marker
          data-index={i}
          aria-label={`${m.year} — ${m.title}`}
          class="group absolute top-1/2 -translate-x-1/2 -translate-y-1/2 cursor-pointer p-0"
          style={`left:${(i / (milestones.length - 1)) * 100}%`}
        >
          <span class="block size-2 rotate-45 border border-hairline bg-panel transition-all duration-300 group-hover:bg-solar group-data-[active]:scale-150 group-data-[active]:border-transparent group-data-[active]:bg-solar"></span>
          <span
            class="absolute top-5 left-1/2 -translate-x-1/2 font-din-narrow text-[13px] font-bold whitespace-nowrap text-ink-muted opacity-0 transition-all duration-300 group-hover:opacity-100 group-data-[active]:translate-y-0 group-data-[active]:text-ink group-data-[active]:opacity-100 [.is-live_&]:translate-y-1.5"
          >
            {m.year}
          </span>
        </button>
      ))}
    </div>

    <div class="mt-14 flex items-center gap-5 font-din text-[12.5px] tracking-[0.1em] text-ink-muted uppercase">
      <span data-readout class="tabular-nums">1 / {milestones.length}</span>
      <span data-hint>Scroll to advance</span>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const section = document.querySelector<HTMLElement>('[data-timeline]');
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const fill = document.querySelector<HTMLElement>('[data-fill]');
  const playhead = document.querySelector<HTMLElement>('[data-playhead]');
  const readout = document.querySelector<HTMLElement>('[data-readout]');

  const reduced = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;

  if (section && stage && !reduced) {
    gsap.registerPlugin(ScrollTrigger);

    /* Switch the stage from a flowing list to a stacked cross-fade. */
    section.classList.add('is-live');

    const slides = gsap.utils.toArray<HTMLElement>('[data-slide]');
    const markers = gsap.utils.toArray<HTMLElement>('[data-marker]');
    const n = slides.length;
    const span = n - 1;

    gsap.set(slides, { autoAlpha: 0 });
    gsap.set(slides[0], { autoAlpha: 1 });

    const setActive = (i: number) => {
      markers.forEach((m, idx) => {
        if (idx === i) m.setAttribute('data-active', '');
        else m.removeAttribute('data-active');
      });
      if (readout) readout.textContent = `${i + 1} / ${n}`;
    };
    setActive(0);

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        pin: true,
        pinSpacing: true,
        scrub: 0.7,
        start: 'center center',
        end: () => '+=' + span * 460,
        invalidateOnRefresh: true,
        anticipatePin: 1,
        onUpdate: (self) => {
          const pct = self.progress * 100;
          if (fill) fill.style.width = `${pct.toFixed(2)}%`;
          if (playhead) playhead.style.left = `${pct.toFixed(2)}%`;
          setActive(Math.round(self.progress * span));
        },
      },
    });

    /* One unit of timeline per milestone. Each slide holds the stage around its
       own beat, fading out as the next one arrives. */
    slides.forEach((slide, i) => {
      const bits = slide.querySelectorAll<HTMLElement>('[data-anim]');
      const img = slide.querySelector<HTMLElement>('[data-slide-img]');

      if (i > 0) {
        tl.fromTo(slide, { autoAlpha: 0, y: 30 }, { autoAlpha: 1, y: 0, duration: 0.3 }, i - 0.3);
        tl.fromTo(bits, { autoAlpha: 0, y: 22 }, { autoAlpha: 1, y: 0, duration: 0.3, stagger: 0.05 }, i - 0.28);
      }
      if (img) {
        tl.fromTo(img, { scale: 1.12 }, { scale: 1, ease: 'none', duration: 1 }, Math.max(0, i - 0.4));
      }
      if (i < n - 1) {
        tl.to(slide, { autoAlpha: 0, y: -30, duration: 0.3 }, i + 0.35);
      }
    });

    /* Jump to a milestone by clicking its marker. */
    markers.forEach((marker, i) => {
      marker.addEventListener('click', () => {
        const st = tl.scrollTrigger;
        if (!st) return;
        const target = st.start + (st.end - st.start) * (span === 0 ? 0 : i / span);
        window.scrollTo({ top: target, behavior: 'smooth' });
      });
    });

    for (const img of document.querySelectorAll('[data-slide-img]')) {
      if (!(img as HTMLImageElement).complete) {
        img.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });
      }
    }
  } else {
    document.querySelector<HTMLElement>('[data-hint]')?.remove();
    document.querySelector<HTMLElement>('[data-readout]')?.remove();
  }
</script>
