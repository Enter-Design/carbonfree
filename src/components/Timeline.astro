---
import { milestones } from '../data/about';
---
<div class="cf-reveal relative mt-1.5 overflow-x-auto border-y border-hairline" data-rail>
  <div
    id="tl-years"
    role="tablist"
    tabindex="0"
    aria-label="CarbonFree milestones by year"
    class="flex min-w-max"
  >
    {milestones.map((m, i) => (
      <button
        type="button"
        role="tab"
        data-index={i}
        aria-selected={i === milestones.length - 1 ? 'true' : 'false'}
        aria-controls="tl-panel"
        class="group relative shrink-0 cursor-pointer border-l border-hairline px-7.5 pt-6.5 pb-7.5 font-din-narrow text-[26px] font-bold whitespace-nowrap text-ink-muted transition duration-200 first:border-l-0 hover:text-ink aria-selected:text-ink"
      >
        {m.year}
        <span class="block font-din text-[11px] font-bold tracking-[0.14em] text-ink-muted uppercase opacity-0 transition duration-200 group-aria-selected:text-solar group-aria-selected:opacity-100">
          {m.tick}
        </span>
        <span class="absolute inset-x-0 bottom-0 h-[3px] origin-left scale-x-0 bg-linear-to-r from-solar to-solar-deep transition-transform duration-300 group-aria-selected:scale-x-100"></span>
      </button>
    ))}
  </div>
</div>

<div id="tl-panel" data-rail class="cf-reveal grid min-h-[430px] border-b border-hairline lg:grid-cols-2">
  <div id="tl-media" class="relative overflow-hidden bg-surface-alt">
    {milestones.map((m, i) => (
      <img
        src={m.img}
        alt=""
        data-index={i}
        class:list={[
          'absolute inset-0 size-full object-cover transition-opacity duration-500',
          i === milestones.length - 1 ? 'opacity-86' : 'opacity-0',
        ]}
      />
    ))}
    <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-veil-light to-transparent to-60%"></div>
  </div>

  <div class="flex flex-col justify-center border-hairline px-8 py-12 max-lg:border-t lg:border-l lg:px-14 lg:py-17">
    <div id="tl-year" class="cf-gradient-text font-din-narrow text-[clamp(42px,5vw,66px)] leading-[0.95] font-bold tracking-[-0.02em]"></div>
    <h3 id="tl-title" class="my-4 max-w-[20ch] text-subhead font-bold"></h3>
    <p id="tl-body" class="max-w-[50ch] text-[16.5px] text-ink-muted"></p>
    <div id="tl-chips" class="mt-6.5 flex flex-wrap gap-2.25"></div>

    <div class="mt-8 flex items-center gap-3">
      <button id="tl-prev" type="button" aria-label="Previous milestone"
        class="grid size-11 cursor-pointer place-items-center border border-hairline text-ink transition duration-200 hover:border-solar hover:text-solar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button id="tl-next" type="button" aria-label="Next milestone"
        class="grid size-11 cursor-pointer place-items-center border border-hairline text-ink transition duration-200 hover:border-solar hover:text-solar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7"/></svg>
      </button>
      <span id="tl-count" class="ml-1.5 font-din text-[13px] text-ink-muted"></span>
    </div>
  </div>
</div>

<script>
  import { milestones } from '../data/about';

  const rail = document.getElementById('tl-years');
  const media = document.getElementById('tl-media');
  if (rail && media) {
    const tabs = [...rail.querySelectorAll<HTMLButtonElement>('button[role="tab"]')];
    const images = [...media.querySelectorAll<HTMLImageElement>('img[data-index]')];
    const yearEl = document.getElementById('tl-year')!;
    const titleEl = document.getElementById('tl-title')!;
    const bodyEl = document.getElementById('tl-body')!;
    const chipsEl = document.getElementById('tl-chips')!;
    const countEl = document.getElementById('tl-count')!;

    let index = milestones.length - 1;

    const go = (next: number, scrollIntoView = true) => {
      index = (next + milestones.length) % milestones.length;
      const m = milestones[index];

      tabs.forEach((tab, i) => tab.setAttribute('aria-selected', String(i === index)));
      images.forEach((img, i) => img.classList.toggle('opacity-86', i === index));
      images.forEach((img, i) => img.classList.toggle('opacity-0', i !== index));

      yearEl.textContent = m.year;
      titleEl.textContent = m.title;
      bodyEl.textContent = m.body;
      chipsEl.replaceChildren(
        ...m.chips.map((c) => {
          const el = document.createElement('span');
          el.className =
            'border border-hairline px-3.25 py-1.75 font-din text-[12.5px] tracking-[0.06em] text-ink uppercase';
          el.textContent = c;
          return el;
        }),
      );
      countEl.textContent = `${index + 1} / ${milestones.length}`;

      if (scrollIntoView) {
        tabs[index].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
    };

    tabs.forEach((tab, i) => tab.addEventListener('click', () => go(i)));
    document.getElementById('tl-prev')?.addEventListener('click', () => go(index - 1));
    document.getElementById('tl-next')?.addEventListener('click', () => go(index + 1));

    rail.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(index + 1); tabs[index].focus(); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index - 1); tabs[index].focus(); }
    });

    go(index, false);
    requestAnimationFrame(() => tabs[index].scrollIntoView({ block: 'nearest', inline: 'center' }));
  }
</script>
