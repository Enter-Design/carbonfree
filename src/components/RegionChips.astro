---
interface Props { items: readonly string[] }
const { items } = Astro.props;
---
<div class="cf-reveal mt-6.5 flex flex-wrap gap-3">
  {items.map((r) => (
    <span class="inline-flex items-center gap-2.5 border border-hairline px-4 py-2.5 font-din text-[13px] tracking-[0.04em] text-ink">
      <span class="size-1.75 rotate-45 bg-signal"></span>{r}
    </span>
  ))}
</div>
