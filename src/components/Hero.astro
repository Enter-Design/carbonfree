---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow: string;
  image: string;
  imageAlt: string;
  trust?: { lead?: string; strong: string; tail?: string }[];
}
const { eyebrow, image, imageAlt, trust = [] } = Astro.props;
---
<section
  data-rail
  class="relative flex min-h-screen items-center overflow-hidden border-b border-hairline pt-30 pb-20"
>
  <div class="absolute inset-0 z-0">
    <img src={image} alt={imageAlt} class="size-full object-cover opacity-40" />
    <div
      class="absolute inset-0 bg-[linear-gradient(90deg,var(--cf-veil-heavy)_6%,var(--cf-veil-mid)_45%,var(--cf-veil-light)),radial-gradient(900px_520px_at_82%_22%,rgb(255_181_36/0.15),transparent_60%)]"
    ></div>
  </div>

  <div class="relative z-2 mx-auto w-full max-w-site px-8">
    <div class="grid items-center gap-8 lg:grid-cols-[1.35fr_0.95fr] lg:gap-18">
      <div class="max-w-[60ch]">
        <Eyebrow class="cf-reveal">{eyebrow}</Eyebrow>
        <slot name="headline" />
        <slot name="lede" />
        <slot name="actions" />

        {trust.length > 0 && (
          <div class="cf-reveal mt-7.5 flex flex-wrap items-center gap-x-4.5 gap-y-2 font-din text-sm text-ink-muted">
            {trust.map((t, i) => (
              <>
                {i > 0 && <span class="text-hairline" aria-hidden="true">&bull;</span>}
                <span>
                  {t.lead}{' '}<b class="font-bold text-signal">{t.strong}</b>{' '}{t.tail}
                </span>
              </>
            ))}
          </div>
        )}
      </div>

      <slot name="aside" />
    </div>
  </div>
</section>
