---
import Card from '../ui/Card.astro';
import { formatDate } from '../../lib/date';
import type { ProjectEvent } from '../../lib/microsite';

/*
  Open houses and public meetings.

  Upcoming events are the single most time-sensitive thing on a consultation
  site — someone deciding whether to attend a meeting next week. So they lead,
  and they are visually distinct from the archive rather than being one
  undifferentiated list.
*/
interface Props {
  events: ProjectEvent[];
  variant?: 'upcoming' | 'past';
}
const { events, variant = 'upcoming' } = Astro.props;
const upcoming = variant === 'upcoming';
---

{events.length > 0 && (
  <div class:list={['grid gap-px', upcoming ? 'sm:grid-cols-2' : 'border-t border-hairline']}>
    {events.map((e) =>
      upcoming ? (
        <Card bar="top" class="cell-inset py-8">
          <div class="font-din text-[13px] tracking-[0.12em] text-solar uppercase">
            {e.date_label ?? formatDate(new Date(e.date), true)}
          </div>
          <h3 class="mt-3 text-[21px] leading-snug font-bold">{e.title}</h3>
          {e.venue && <p class="mt-2.5 text-[15px] text-ink">{e.venue}</p>}
          {e.address && <p class="mt-1 text-[14.5px] text-ink-muted">{e.address}</p>}
          {e.details && <p class="mt-4 max-w-[54ch] text-[15px] text-ink-muted">{e.details}</p>}
          {e.url && (
            <a
              href={e.url}
              class="mt-5 inline-flex items-center gap-2 text-[15px] font-bold text-solar underline underline-offset-4"
            >
              Event details <span aria-hidden="true">&rarr;</span>
            </a>
          )}
        </Card>
      ) : (
        <div class="grid gap-x-8 gap-y-1.5 border-b border-hairline py-5 lg:grid-cols-[190px_1fr]">
          <div class="font-din text-[12.5px] tracking-[0.1em] text-ink-muted uppercase">
            {e.date_label ?? formatDate(new Date(e.date), true)}
          </div>
          <div class="min-w-0">
            <h3 class="text-[17px] font-bold">{e.title}</h3>
            {(e.venue || e.address) && (
              <p class="mt-1 text-[14.5px] text-ink-muted">
                {[e.venue, e.address].filter(Boolean).join(' · ')}
              </p>
            )}
            {e.details && <p class="mt-2 max-w-[70ch] text-[14.5px] text-ink-muted">{e.details}</p>}
          </div>
        </div>
      ),
    )}
  </div>
)}
