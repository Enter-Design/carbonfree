---
import Eyebrow from './Eyebrow.astro';
import { site } from '../data/site';

interface Field {
  label: string;
  type?: 'text' | 'email' | 'tel' | 'textarea' | 'select';
  options?: string[];
  half?: boolean;
}

interface Props {
  title: string;
  body: string;
  showDoors?: boolean;
  eyebrow?: string;
  submit?: string;
  note?: string;
  /** Override the default field set — used by the audience landing pages. */
  fields?: Field[];
}

const roles = ['Landowner', 'Electricity customer', 'First Nations community', 'Investor / sponsor', 'Media', 'Other'];

const defaultFields: Field[] = [
  { label: 'Full name', half: true },
  { label: 'Organization', half: true },
  { label: 'Email', type: 'email', half: true },
  { label: 'I’m a…', type: 'select', options: roles, half: true },
  { label: 'How can we help?', type: 'textarea' },
];

const {
  title,
  body,
  showDoors = false,
  eyebrow = 'Work with us',
  submit = 'Send message',
  note,
  fields = defaultFields,
} = Astro.props;

const slug = (s: string) => 'f-' + s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const fieldBase =
  'w-full border border-hairline bg-veil-field px-3.75 py-3.25 text-[15px] text-ink transition duration-200 outline-none focus:border-solar focus:bg-solar/[0.04]';
const labelBase = 'mb-2 block font-din text-[13px] font-bold tracking-[0.04em] text-ink-muted uppercase';
---
<section id="contact">
  <div class="relative overflow-hidden border-y border-hairline">
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1497435334941-8c899ee9e8e9?auto=format&fit=crop&w=2000&q=80"
        alt=""
        class="size-full object-cover opacity-30"
      />
      <div class="absolute inset-0 bg-[radial-gradient(820px_420px_at_50%_0,rgb(255_138_0/0.26),transparent_60%)] bg-veil-mid"></div>
    </div>

    <div class="relative z-2 mx-auto grid max-w-site lg:max-w-none lg:grid-cols-2">
      <div class="cf-reveal flex flex-col justify-center px-8 pt-18 pb-6 lg:py-24 lg:pr-16 lg:edge-gutter-l">
        <Eyebrow>{eyebrow}</Eyebrow>
        <h2 class="mt-4.5 mb-5 max-w-[18ch] text-headline font-bold" set:html={title} />
        <p class="max-w-[46ch] text-lg text-ink-muted">{body}</p>
        {showDoors && (
          <div class="mt-7.5 flex flex-wrap gap-4">
            <a href="/landowners" class="inline-flex items-center gap-2.5 border border-transparent bg-linear-[135deg,var(--cf-solar),var(--cf-solar-deep)] px-[30px] py-[15px] text-[15px] font-bold text-[#1a1205] transition duration-200 hover:-translate-y-0.5">I have land to lease &rarr;</a>
            <a href="/clean-power" class="inline-flex items-center gap-2.5 border border-hairline bg-white/[0.02] px-[30px] py-[15px] text-[15px] font-bold text-ink transition duration-200 hover:border-solar hover:text-solar">I have power costs to hedge &rarr;</a>
          </div>
        )}
      </div>

      <div class="cf-reveal border-hairline bg-veil-panel px-8 py-10 backdrop-blur-[6px] lg:border-l lg:py-16 lg:pl-16 lg:edge-gutter-r">
        <form>
          <div class="grid gap-x-4 sm:grid-cols-2">
            {fields.map((f) => (
              <div class:list={['mb-4', !f.half && 'sm:col-span-2']}>
                <label class={labelBase} for={slug(f.label)} set:html={f.label} />
                {f.type === 'textarea' ? (
                  <textarea id={slug(f.label)} class:list={[fieldBase, 'min-h-21 resize-y']}></textarea>
                ) : f.type === 'select' ? (
                  <select id={slug(f.label)} class={fieldBase}>
                    {(f.options ?? []).map((o) => <option>{o}</option>)}
                  </select>
                ) : (
                  <input id={slug(f.label)} class={fieldBase} type={f.type ?? 'text'} />
                )}
              </div>
            ))}
          </div>
          <button
            type="submit"
            class="mt-2 w-full justify-center border border-transparent bg-linear-[135deg,var(--cf-solar),var(--cf-solar-deep)] px-[30px] py-[15px] text-[15px] font-bold text-[#1a1205] transition duration-200 hover:-translate-y-0.5"
          >
            {submit}
          </button>
          <p class="mt-3.5 text-center font-din text-[13px] text-ink-muted">
            {note ?? `${site.name} Inc. · ${site.address}`}
          </p>
        </form>
      </div>
    </div>
  </div>
</section>
