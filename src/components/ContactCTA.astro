---
import Eyebrow from './Eyebrow.astro';

interface Field {
  label: string;
  type?: 'text' | 'email' | 'tel' | 'textarea' | 'select';
  options?: string[];
  half?: boolean;
}

interface Props {
  title: string;
  body: string;
  showDoors?: boolean;
  eyebrow?: string;
  submit?: string;
  note?: string;
  /** Override the default field set — used by the audience landing pages. */
  fields?: Field[];
}

const roles = ['Landowner', 'Electricity customer', 'First Nations community', 'Investor / sponsor', 'Media', 'Other'];

const defaultFields: Field[] = [
  { label: 'Full name', half: true },
  { label: 'Organization', half: true },
  { label: 'Email', type: 'email', half: true },
  { label: 'I’m a…', type: 'select', options: roles, half: true },
  { label: 'How can we help?', type: 'textarea' },
];

const {
  title,
  body,
  showDoors = false,
  eyebrow = 'Work with us',
  submit = 'Send message',
  note,
  fields = defaultFields,
} = Astro.props;

const slug = (s: string) => 'f-' + s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

/*
  Reassurance, not a mailing address — the address is already in the footer, and
  under a submit button the useful thing to say is what happens next. Pages with
  a more specific promise (the two landing pages) override this with `note`.
*/
const DEFAULT_NOTE =
  'No obligation &middot; You&rsquo;ll hear back from the CarbonFree team in Toronto';
const fieldBase =
  'w-full border border-hairline bg-veil-field px-3.75 py-3.25 text-[15px] text-ink transition duration-200 outline-none focus:border-solar focus:bg-solar/[0.04]';
const labelBase = 'mb-2 block font-din text-[13px] font-bold tracking-[0.04em] text-ink-muted uppercase';
---
<section id="contact">
  <div class="relative overflow-hidden border-y border-hairline">
    {/*
      The image was at 30% opacity under a 72% wash of the page colour, which in
      daylight is a near-white scrim over a near-transparent photo — hence the
      washed-out look. Photographs shouldn't ride the veil tokens; those are for
      scrims behind text. The image now sits at full strength with a fixed dark
      scrim, and the copy gets its own plate for legibility.
    */}
    <div class="absolute inset-0 z-0 bg-[#0b0d0f]">
      <img
        src="https://images.unsplash.com/photo-1497435334941-8c899ee9e8e9?auto=format&fit=crop&w=2000&q=80"
        alt=""
        class="size-full object-cover opacity-90"
      />
      <div class="absolute inset-0 bg-[radial-gradient(820px_420px_at_50%_0,rgb(255_138_0/0.22),transparent_60%)]"></div>
      <div class="absolute inset-0 bg-linear-to-r from-black/75 via-black/45 to-black/20"></div>
    </div>

    <div class="relative z-2 mx-auto grid max-w-site lg:max-w-none lg:grid-cols-2">
      <div class="cf-reveal flex flex-col justify-center px-8 pt-18 pb-6 lg:py-24 lg:pr-16 lg:edge-gutter-l">
        <Eyebrow>{eyebrow}</Eyebrow>
        <h2 class="mt-4.5 mb-5 max-w-[18ch] text-headline font-bold text-white" set:html={title} />
        <p class="max-w-[46ch] text-lg text-white/70" set:html={body} />
        {showDoors && (
          <div class="mt-7.5 flex flex-wrap gap-4">
            <a href="/landowners" class="inline-flex items-center gap-2.5 border border-transparent bg-linear-[135deg,var(--cf-solar),var(--cf-solar-deep)] px-[30px] py-[15px] text-[15px] font-bold text-[#1a1205] transition duration-200 hover:-translate-y-0.5">I have land to lease &rarr;</a>
            <a href="/clean-power" class="inline-flex items-center gap-2.5 border border-white/25 bg-white/[0.06] px-[30px] py-[15px] text-[15px] font-bold text-white transition duration-200 hover:border-solar hover:text-solar">I have power costs to hedge &rarr;</a>
          </div>
        )}
      </div>

      {/*
        `bg-panel`, not `bg-white`. The plate has to stay opaque white in
        daylight but still flip with the palette, because everything inside it
        — `text-ink`, `text-ink-muted`, `bg-veil-field` — is palette-driven.
        Pinning the plate to literal white would leave near-white `text-ink` on
        a white field whenever the page is in its night palette: before the
        sunrise runs, during the 650ms sunset on navigation away, and on any
        load where the script doesn't run. `--cf-panel` is #ffffff by day and
        #0e1113 at night, so the pairing holds at both ends and through the lerp.
        Opaque, so no backdrop-blur — there is nothing left to see through.
      */}
      <div class="cf-reveal border-hairline bg-panel px-8 py-10 lg:border-l lg:py-16 lg:pl-16 lg:edge-gutter-r">
        <form>
          <div class="grid gap-x-4 sm:grid-cols-2">
            {fields.map((f) => (
              <div class:list={['mb-4', !f.half && 'sm:col-span-2']}>
                <label class={labelBase} for={slug(f.label)} set:html={f.label} />
                {f.type === 'textarea' ? (
                  <textarea id={slug(f.label)} class:list={[fieldBase, 'min-h-21 resize-y']}></textarea>
                ) : f.type === 'select' ? (
                  <select id={slug(f.label)} class={fieldBase}>
                    {(f.options ?? []).map((o) => <option>{o}</option>)}
                  </select>
                ) : (
                  <input id={slug(f.label)} class={fieldBase} type={f.type ?? 'text'} />
                )}
              </div>
            ))}
          </div>
          <button
            type="submit"
            class="mt-2 w-full justify-center border border-transparent bg-linear-[135deg,var(--cf-solar),var(--cf-solar-deep)] px-[30px] py-[15px] text-[15px] font-bold text-[#1a1205] transition duration-200 hover:-translate-y-0.5"
          >
            {submit}
          </button>
          <p class="mt-3.5 text-center font-din text-[13px] text-ink-muted" set:html={note ?? DEFAULT_NOTE} />
        </form>
      </div>
    </div>
  </div>
</section>
