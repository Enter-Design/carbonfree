---
import { stats } from '../data/site';
---
<div data-rail class="border-b border-hairline bg-surface-alt">
  <div class="mx-auto w-full max-w-site px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4">
      {stats.map((s, i) => (
        <div
          class:list={[
            'cf-reveal border-hairline px-8 py-12',
            'border-l',
            i % 2 === 0 && 'max-lg:border-l-0 max-lg:pl-0',
            i > 1 && 'max-lg:border-t',
            i === stats.length - 1 && 'lg:border-r',
          ]}
        >
          <div class="font-din-narrow text-stat font-bold tracking-[-0.01em]">
            <span class="cf-gradient-text">
              {s.value}{'unit' in s && s.unit && <sub>{s.unit}</sub>}
            </span>
          </div>
          <div class="mt-2 text-sm text-ink-muted">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</div>
