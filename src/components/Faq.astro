---
interface Item { q: string; a: string }
interface Props { items: readonly Item[] }
const { items } = Astro.props;
---
<div data-rail class="cf-reveal border-t border-hairline">
  {items.map((item) => (
    <details class="group border-b border-hairline">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-6 pl-(--cf-inset) py-6.5 text-[17.5px] font-bold transition duration-200 hover:text-solar [&::-webkit-details-marker]:hidden">
        {item.q}
        <span class="mt-1 shrink-0 text-solar transition-transform duration-300 group-open:rotate-45" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        </span>
      </summary>
      <p class="max-w-[74ch] pl-(--cf-inset) pb-7 text-[16.5px] text-ink-muted" set:html={item.a} />
    </details>
  ))}
</div>
