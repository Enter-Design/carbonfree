---
import Eyebrow from './Eyebrow.astro';

interface Props {
  flag: string;
  label?: string;
}
const { flag, label } = Astro.props;
---
<aside
  class="cf-reveal relative border border-hairline bg-white/[0.03] px-6.5 pt-6.5 pb-5.5 backdrop-blur-lg"
  aria-label={label ?? flag}
>
  <span class="absolute inset-y-0 left-0 w-[3px] bg-linear-to-b from-solar to-solar-deep"></span>
  <Eyebrow class="mb-4 !text-xs !tracking-[0.16em]">{flag}</Eyebrow>
  <slot />
</aside>
